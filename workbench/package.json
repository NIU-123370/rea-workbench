{
  "name": "rea-workbench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local single-user software archaeology workbench on REA 6.4.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "npm run test:unit && npm run test:integration",
    "lint": "oxlint packages apps tests infra",
    "review": "node infra/review/scan.mjs --json .review/findings.json --summary .review/summary.md",
    "review:post": "node infra/review/post.mjs",
    "worker": "node apps/worker/main.ts",
    "doctor": "node apps/worker/main.ts --doctor",
    "docs:check": "node infra/release/docs-check.mjs",
    "perf:t17": "node infra/perf/t17-graph-update.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.6.7"
  }
}
